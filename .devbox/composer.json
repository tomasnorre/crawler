{
    "name": "tomasnorre/crawler-devbox",
    "description": "Devbox for TYPO3 Crawler",
    "license": "GPL-3.0",
    "type": "project",
    "authors": [
        {
            "name": "Tomas Norre Mikkelsen",
            "email": "tomasnorre@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/tomasnorre/crawler",
    "support": {
        "issues": "https://github.com/tomasnorre/crawler/issues"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/crawler",
            "options": {
                "symlink": true,
                "versions": {
                    "tomasnorre/crawler": "14.0.x-dev"
                }
            }
        }
    ],
    "require": {
        "georgringer/news": "^14",
        "tnm/crawler-devbox-sitepackage": "^0.0.5",
        "tomasnorre/crawler": "^14.0@dev",
        "typo3/cms-belog": "^14.3",
        "typo3/cms-beuser": "^14.3",
        "typo3/cms-felogin": "^14.3",
        "typo3/cms-indexed-search": "^14.3",
        "typo3/cms-info": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-scheduler": "^14.3",
        "typo3/cms-tstemplate": "^14.3",
        "typo3/minimal": "^14.3",
	    "typo3/cms-core": "^14.3"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "conflict": {
        "symfony/dependency-injection": "7.4.0",
        "tomasnorre/crawler": "<12.0.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": "bin",
        "vendor-dir": "vendor"
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": "public"
        }
    }
}
