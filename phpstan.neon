includes:
    - phpstan-baseline.neon
    # For cognitive rules - These a include from the phpstan/extension-installer
    #- .Build/vendor/symplify/phpstan-rules/config/packages/cognitive-complexity/cognitive-complexity-services.neon
    #- .Build/vendor/symplify/phpstan-rules/config/services/services.neon

parameters:
    level: 8
    paths:
        - "Classes/"
        - "Configuration/"
    excludePaths:
        - Classes/CrawlStrategy/GuzzleExecutionStrategy.php
        - Documentation

    inferPrivatePropertyTypeFromConstructor: true

    # Request attributes that saschaegerer/phpstan-typo3 doesn't know by default
    typo3:
        requestGetAttributeMapping:
            route: TYPO3\CMS\Backend\Routing\Route
            tx_crawler: 'array<string, mixed>'

    ignoreErrors:
        # Being removed folder by folder, drop a path once its errors are fixed
        -
            identifier: missingType.iterableValue
            paths:
                - Classes/Command/*
                - Classes/Configuration/*
                - Classes/ContextMenu/*
                - Classes/Controller/*
                - Classes/CrawlStrategy/*
                - Classes/Middleware/*
                - Classes/Queue/*
                - Classes/QueueExecutor.php
                - Classes/Service/*
                - Classes/Utility/*
                - Classes/Writer/*

    # composer require tomasvotruba/type-coverage --dev
    # Typed class constants need PHP 8.3, PHP 8.2 is still supported
    type_coverage:
        constant_type: 0

services:
    -
        class: Symplify\PHPStanRules\Rules\ForbiddenFuncCallRule
        tags: [phpstan.rules.rule]
        arguments:
            forbiddenFunctions:
                - eval
                - dump
                - die
                - d
                - compact
                - var_dump
